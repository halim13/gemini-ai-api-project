rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document by matching UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Verify if a chat document exists and belongs to the authenticated user
    function chatBelongsToUser(chatId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }

    // Users Collection: Only the authenticated user can read or write their own user profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Chats Collection: Users can manage their own chats
    match /chats/{chatId} {
      // Allow reading and deleting only if the chat already belongs to the authenticated user
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow creation only if the user lists themselves as the owner
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Allow updates (e.g. updating title or updatedAt timestamp) only if the chat belongs to the user and the owner field is unchanged
      allow update: if isAuthenticated() && 
                    resource.data.userId == request.auth.uid && 
                    request.resource.data.userId == request.auth.uid;
      
      // Subcollection of Messages: chats/{chatId}/messages/{messageId}
      match /messages/{messageId} {
        // Users can read or write messages only if the parent chat belongs to them
        allow read, write: if chatBelongsToUser(chatId);
      }
    }
  }
}
